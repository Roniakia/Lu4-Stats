# Run ops/prepare-homelab.sh instead of copying placeholder passwords.
# These tags must be built/loaded on the homelab's CPU architecture.
TOOLS_IMAGE=lu4-tools:v2-homelab-amd64
COLLECTOR_IMAGE=lu4-collector:v2-homelab-amd64
DB_BIND_ADDRESS=127.0.0.1
DATABASE_PASSWORD_FILE=/srv/lu4/secrets/database-password
# Hex passwords avoid URL escaping; generator writes a matching secret file.
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_HEX
APP_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_HEX
COLLECTOR_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_HEX
ADMIN_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_HEX
MIGRATION_DATABASE_URL=postgresql://lu4_migration:${DATABASE_PASSWORD}@database:5432/lu4
COLLECTOR_DATABASE_URL=postgresql://lu4_collector:${COLLECTOR_DATABASE_PASSWORD}@database:5432/lu4
ADMIN_DATABASE_URL=postgresql://lu4_admin:${ADMIN_DATABASE_PASSWORD}@database:5432/lu4
ARCHIVE_DIRECTORY=/srv/lu4/archives
EXPORT_DIRECTORY=/srv/lu4/exports
BACKUP_DIRECTORY=/srv/lu4/backups
