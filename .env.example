SNAPSHOT_GIT_REMOTE=git@github.com:Roniakia/Lu4-Stats.git
SNAPSHOT_GIT_BRANCH=data
PUBLISH_INTERVAL_SECONDS=900
# Match these to the SSH key owner's id -u and id -g on the host.
PUBLISHER_UID=1000
PUBLISHER_GID=1000
# Host file paths required by docker-compose.yml.
GITHUB_SSH_KEY_PATH=/home/your-user/.ssh/id_ed25519
GITHUB_KNOWN_HOSTS_PATH=/home/your-user/.ssh/known_hosts
# Chromium sandbox runs inside Docker with the included seccomp profile.
CHROMIUM_SANDBOX=true
# Set if Chrome/Chromium is not in a standard location.
# MW2_BROWSER_EXECUTABLE=/usr/bin/chromium
# Optional commit identity.
# SNAPSHOT_GIT_NAME=Lu4 Stats Snapshot Bot
# SNAPSHOT_GIT_EMAIL=lu4-stats-bot@users.noreply.github.com
