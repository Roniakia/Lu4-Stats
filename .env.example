# Optional: override this if you mount the deploy key somewhere else.
# Default Unraid path: /mnt/user/appdata/lu4-stats-snapshot-publisher/github_deploy_key
# GITHUB_SSH_KEY_PATH=/path/to/github_deploy_key

# Optional schedule override (default: every 15 minutes).
# PUBLISH_INTERVAL_SECONDS=900

# Optional: enable only on Docker hosts where Chromium sandbox namespaces work.
# CHROMIUM_SANDBOX=true
