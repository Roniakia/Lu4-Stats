{
  "name": "lu4-stats-snapshot-publisher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "publish:snapshots": "node publish-snapshots.js",
    "start": "node scheduler.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:import": "node scripts/import-history.mjs",
    "collector:database": "node scripts/collector.mjs",
    "test:homelab": "node --test tests/*.test.js && node tests/storage.cjs && node tests/admin-report.cjs && node tests/operations.cjs"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "playwright-core": "^1.55.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
